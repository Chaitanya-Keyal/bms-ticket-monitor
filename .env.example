# Telegram bot token (from @BotFather). Or point TELEGRAM_BOT_TOKEN_FILE at a file holding it.
TELEGRAM_BOT_TOKEN=
# Where alerts go: your user id for a direct chat with the bot, or a group/channel id.
TELEGRAM_CHAT_ID=
# Optional: a forum topic id inside that chat.
TELEGRAM_THREAD_ID=

# Seconds between checks (each one is slightly randomised).
BMS_INTERVAL=60
# Seconds between full scans of a movie once its booking is open (the opening itself
# is still caught at BMS_INTERVAL). Lower = faster news of new cinemas, more requests.
BMS_OPEN_INTERVAL=120
# ...but for this many seconds after opening (when cinemas and the best seats appear),
# every check scans fully.
BMS_OPEN_FAST_FOR=3600
# Consecutive failed checks before a "checks are failing" alert. Checks back off after
# failures (2, 4, then 5 min apart), so 3 failures is about 7 minutes. 0 turns the
# alert off, e.g. when an outside monitor reads status.json (see README) instead.
BMS_FAIL_ALERT_AFTER=3
# Optional backup route for BookMyShow requests (e.g. a home connection), e.g. socks5h://host:1080.
# Direct stays the main route; the backup is used only while direct is blocked by
# Cloudflare (direct is retried every 30 min). An unreachable backup is skipped for 5 min.
BMS_PROXY=
# Daily "still watching" message at this local time (HH:MM); empty to turn off.
BMS_HEARTBEAT_AT=10:00
# Local time zone for that, as a POSIX TZ string (works without tz data), e.g. IST-5:30
TZ=IST-5:30

# Optional phone call (Twilio Programmable Voice): one call per movie at its first heads-up or
# opening, only within 30 minutes of it. Leave CALL_TO empty for no calls.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# or TWILIO_API_KEY_SECRET_FILE=/run/secrets/twilio_api_key_secret
CALL_FROM=
CALL_TO=
